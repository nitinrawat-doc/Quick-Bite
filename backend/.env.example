# QuickBite Backend — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file with real secrets to version control.

# ─── Server Configuration ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ─── MongoDB Database ──────────────────────────────────────────────────────────
# Use MongoDB Atlas for production (Vercel requires a cloud-hosted database)
# Local: mongodb://127.0.0.1:27017/quickbite
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/quickbite?retryWrites=true&w=majority
MONGODB_URI=

# ─── Authentication & JWT ───────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_jwt_secret_at_least_64_chars
JWT_EXPIRES_IN=7d

# ─── Admin Setup Secret ──────────────────────────────────────────────────────────
# Required only once for POST /api/auth/setup-admin to create the first admin account
ADMIN_SETUP_SECRET=replace_with_a_secure_admin_setup_secret_token

# ─── Razorpay Online Payments ────────────────────────────────────────────────────
# Obtain from Razorpay Dashboard > Settings > API Keys
# Test keys start with rzp_test_  |  Live keys start with rzp_live_
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Then paste the same value into Razorpay Dashboard > Settings > Webhooks > Secret
RAZORPAY_WEBHOOK_SECRET=

# ─── Cloudinary Image Hosting ────────────────────────────────────────────────────
# Required in production (Vercel has no persistent filesystem for local uploads)
# Obtain from https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── CORS & Client URL ───────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
# Example: https://quickbite.vercel.app,https://quickbite-staging.vercel.app
CLIENT_URL=http://localhost:5173
