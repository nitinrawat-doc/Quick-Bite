# QuickBite Backend — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file with real secrets to version control.

# ─── Server Configuration ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB Database ─────────────────────────────────────────────────────────
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/quickbite
# MongoDB Atlas (Cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/quickbite?retryWrites=true&w=majority

# ─── Authentication & JWT ──────────────────────────────────────────────────────
# Generate a strong 64-character secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# ─── Admin Setup & Onboarding Secret ───────────────────────────────────────────
# Secret token required to register initial admin account via POST /api/auth/setup-admin
ADMIN_SETUP_SECRET=replace_with_a_secure_admin_setup_secret_token

# ─── Razorpay Online Payments (Sandbox / Production) ───────────────────────────
# Obtain from Razorpay Dashboard > Settings > API Keys
# Test keys start with 'rzp_test_', Live keys start with 'rzp_live_'
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Secret configured in Razorpay Dashboard > Settings > Webhooks
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─── Cloudinary Image Hosting (Optional — falls back to local storage) ─────────
# Obtain from Cloudinary Console Dashboard
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Client URL & CORS Settings ───────────────────────────────────────────────
# Comma-separated allowed frontend origins for CORS
CLIENT_URL=http://localhost:5173
