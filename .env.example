# ──────────────────────────────────────────────────────────────────────────────
# QuickBite Full-Stack MERN — Environment Configuration Template
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env before starting Docker:
#   cp .env.example .env          (macOS / Linux)
#   copy .env.example .env        (Windows Command Prompt)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# NEVER commit the real .env file with production secrets to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ─── 1. MongoDB Atlas Configuration (REQUIRED) ────────────────────────────────
# Your MongoDB Atlas connection string.
# IMPORTANT FOR RUNNING ON ANOTHER LAPTOP / NEW NETWORK:
#   In MongoDB Atlas -> Network Access -> Add IP Address:
#   Add '0.0.0.0/0' (Allow access from anywhere) or whitelist your friend's IP.
# Example format:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/quickbite?retryWrites=true&w=majority
MONGODB_URI=

# ─── 2. Security & Authentication (REQUIRED) ──────────────────────────────────
# Strong random secret for signing JWT access tokens (at least 32-64 characters).
# Generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# ─── 3. Initial Admin Onboarding Secret (REQUIRED) ────────────────────────────
# Secret passphrase required to register the initial administrator account via:
# POST /api/auth/setup-admin
ADMIN_SETUP_SECRET=replace_with_a_secure_admin_setup_secret_token

# ─── 4. Razorpay Payments (OPTIONAL for testing / REQUIRED for Live) ──────────
# Obtain from Razorpay Dashboard -> Settings -> API Keys
# Test keys start with 'rzp_test_', Live keys start with 'rzp_live_'
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret configured in Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=

# ─── 5. Cloudinary Image Storage (OPTIONAL — falls back to local disk storage) ──
# Obtain from https://console.cloudinary.com
# If left empty, custom uploaded dish images are saved to local persistent Docker volume.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── 6. Docker Port Mappings (OPTIONAL — defaults provided) ────────────────────
# Port where QuickBite frontend UI will be accessible in browser
FRONTEND_PORT=5173

# Port where QuickBite backend API will be accessible directly
BACKEND_PORT=5000

# ─── 7. CORS Configuration (OPTIONAL) ──────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173,http://localhost:80,http://localhost:3000,http://localhost,http://127.0.0.1:5173,http://127.0.0.1:80

# ─── 8. Frontend API Configuration (OPTIONAL) ──────────────────────────────────
# Leave blank to use Nginx reverse proxy (/api) seamlessly without CORS issues
VITE_API_URL=

