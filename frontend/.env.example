# QuickBite Frontend — Environment Variables Template
# Copy this file to .env or set in your hosting platform (Vercel, Netlify, etc.)

# In local development, leave unset so requests proxy to http://localhost:5000/api via vite.config.js
# In production, set to your deployed backend API URL (e.g. https://your-backend-api.onrender.com/api)
VITE_API_URL=
